<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Calibration Certificate Verification</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #4338ca;
            --primary-hover: #3730a3;
            --secondary: #3b82f6;
            --success: #10b981;
            --success-light: #d1fae5;
            --warning: #f59e0b;
            --warning-light: #fef3c7;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --bg-body: #f8fafc;
            --card-bg: rgba(255, 255, 255, 0.95);
            --border-color: #e2e8f0;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-body);
            background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
            background-size: 24px 24px;
            color: var(--text-dark);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 1.5rem;
            -webkit-font-smoothing: antialiased;
        }

        .container {
            width: 100%;
            /* Default mobile width */
            max-width: 450px; 
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
            margin: 0 auto;
        }

        /* Medium Devices (md) */
        @media (min-width: 768px) {
            .container {
                max-width: 650px;
            }
        }

        /* Large Devices (lg) */
        @media (min-width: 1024px) {
            .container {
                max-width: 800px;
            }
        }

        .glass-card {
            background: var(--card-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.4);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.1), 0 10px 15px -5px rgba(0, 0, 0, 0.04);
        }

        .header {
            background: linear-gradient(135deg, var(--secondary) 0%, var(--primary) 100%);
            padding: 2rem 1.5rem;
            text-align: center;
            color: white;
            position: relative;
        }

        .header::after {
            content: '';
            position: absolute;
            top: -50px;
            right: -50px;
            width: 150px;
            height: 150px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            filter: blur(20px);
        }

        .header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            margin-bottom: 0.25rem;
        }

        .header p {
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            opacity: 0.8;
        }

        .content {
            padding: 2rem 1.5rem;
        }

        .status-icon {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: -3.5rem auto 1.5rem;
            background: white;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            position: relative;
            z-index: 10;
        }

        .status-icon.success {
            border: 4px solid var(--success-light);
            color: var(--success);
        }

        .status-icon.warning {
            border: 4px solid var(--warning-light);
            color: var(--warning);
        }

        .status-icon svg {
            width: 32px;
            height: 32px;
        }

        .status-text {
            text-align: center;
            margin-bottom: 2rem;
        }

        .status-text h2 {
            font-size: 1.25rem;
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .status-text p {
            font-size: 0.875rem;
            color: var(--text-muted);
            line-height: 1.5;
        }

        .info-section {
            background: rgba(248, 250, 252, 0.8);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 1.25rem;
            margin-bottom: 1.5rem;
        }

        .info-section h3 {
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 1rem;
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 0.5rem;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0.75rem;
            font-size: 0.875rem;
            gap: 1rem;
        }

        .info-row:last-child {
            margin-bottom: 0;
        }

        .info-label {
            color: var(--text-muted);
            flex-shrink: 0;
            white-space: nowrap;
        }

        .info-value {
            font-weight: 600;
            text-align: right;
            flex-grow: 1;
            word-break: normal;
        }

        .highlight-section {
            background: rgba(239, 246, 255, 0.7);
            border: 1px solid #bfdbfe;
        }

        .highlight-section h3 {
            color: var(--secondary);
            border-bottom-color: #dbeafe;
        }

        .btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 1rem;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1rem;
            text-decoration: none;
            transition: all 0.2s ease;
            cursor: pointer;
            border: none;
            gap: 0.5rem;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
            box-shadow: 0 4px 14px 0 rgba(67, 56, 202, 0.39);
        }

        .btn-primary:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(67, 56, 202, 0.23);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .btn svg {
            width: 20px;
            height: 20px;
        }

        .footer {
            background: #f8fafc;
            padding: 1rem;
            text-align: center;
            border-top: 1px solid var(--border-color);
            font-size: 0.75rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Mobile specific adjustments */
        @media (max-width: 480px) {
            body { padding: 1rem; }
            .content { padding: 1.5rem 1rem; }
            .header { padding: 1.5rem 1rem; }
            .status-icon { margin-top: -3rem; }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="glass-card">
            
            <!-- Header Section -->
            <div class="header">
                <h1>Calibmaster</h1>
                <p>Digital Verification</p>
            </div>

            <div class="content">
                <% if (status === 'active') { %>
                    <!-- Status Icon -->
                    <% if (fileExists) { %>
                        <div class="status-icon success">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <div class="status-text">
                            <h2>Certificate Validated</h2>
                            <p>This equipment has a verified and active calibration record in the database.</p>
                        </div>
                    <% } else { %>
                        <div class="status-icon warning">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                            </svg>
                        </div>
                        <div class="status-text">
                            <h2 style="color: var(--warning)">Certificate File Missing</h2>
                            <p>Verification data was found, but the certificate file is missing from the server.</p>
                        </div>
                    <% } %>
                    
                    <!-- Equipment Details -->
                    <div class="info-section">
                        <h3>Equipment Details</h3>
                        <div class="info-row">
                            <span class="info-label">ID Number:</span>
                            <span class="info-value"><%= equipmentNo %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Instrument:</span>
                            <span class="info-value"><%= instrumentName %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Make / Model:</span>
                            <span class="info-value"><%= make %> / <%= model %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Serial No:</span>
                            <span class="info-value"><%= serialNo %></span>
                        </div>
                        <% if(equipment_status) { %>
                        <div class="info-row">
                            <span class="info-label">Equipment Status:</span>
                            <span class="info-value"><%= equipment_status %></span>
                        </div>
                        <% } %>
                    </div>

                    <!-- Calibration Info -->
                    <div class="info-section highlight-section">
                        <h3>Latest Calibration</h3>
                        <div class="info-row">
                            <span class="info-label">Done Date:</span>
                            <span class="info-value"><%= calibrationDate %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Valid Upto:</span>
                            <span class="info-value"><%= calibrationDueDate %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Customer:</span>
                            <span class="info-value"><%= customerName %></span>
                        </div>
                        <div class="info-row">
                            <span class="info-label">Cert No:</span>
                            <span class="info-value" style="font-family: monospace;"><%= certificateNo %></span>
                        </div>
                    </div>

                    <!-- Action Button -->
                    <% if (fileExists) { %>
                        <a href="<%= downloadUrl %>" class="btn btn-primary" target="_blank">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                            View Certificate
                        </a>
                    <% } else { %>
                        <div style="text-align: center; font-size: 0.875rem; color: var(--text-muted); font-style: italic;">
                            Please contact administrator to restore this document.
                        </div>
                    <% } %>

                <% } else { %>
                    <!-- Pending/Not Found Status -->
                    <div class="status-icon warning">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                    </div>
                    
                    <div class="status-text">
                        <h2>No Active Certificate</h2>
                        <p>We couldn't find a completed calibration certificate for this equipment in our database.</p>
                    </div>

                    <div class="info-section">
                        <div class="info-row">
                            <span class="info-label">Scanned ID:</span>
                            <span class="info-value"><%= equipmentNo %></span>
                        </div>
                    </div>

                    <p style="text-align: center; font-size: 0.875rem; color: var(--text-muted); margin-top: 2rem;">
                        If you believe this is an error, please contact the laboratory administrator.
                    </p>
                <% } %>
            </div>
            
            <!-- Footer -->
            <div class="footer">
                Powered by Calibmaster
            </div>
        </div>
    </div>

</body>
</html>

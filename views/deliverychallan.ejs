<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DELIVERY CHALLAN</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .container {
            width: 790px;
            margin: 25px auto 0;
        }

        .header div {
            width: 50%;
        }

        .header img {
            width: 190px;
        }

        .leftH p {
            margin: 0;
            margin-bottom: 3px;
            font-size: 16px;
        }
    </style>
</head>

<body>

    <div class="container">

        <div class="header" style="margin-bottom: 20px;">
            <div class="leftH" style="float: left;">
                <p>
                    <%= existingLab.address1 %>
                </p>
                <p>
                    <%= existingLab.address2 %>
                </p>
                <p>
                    <%= existingLab.city %> - <%= existingLab.pincode %>
                </p>
                <p>
                    Telephone: <%= existingLab.contact_number1 %>; e-mail: <%= existingLab.contact_email %>
                </p>
                <p><b>GST No.: <%= existingLab.gst_number %></b></p>
            </div>
            <div class="rightH" style="float: right; text-align: right;">
                <img src="<%= BACKEND_SERVER %>/images/<%= existingLab.brand_logo_filename %>"
                    alt="<%= existingLab.brand_logo_filename %>" style="width: 100px;" />
            </div>
            <div class="spacer" style="clear: both;"></div>
        </div>

        <div class="mainSection" style="clear:both;">

            <table style="width: 100%; border: 2px solid black;">
                <tr>
                    <th style="text-align: left; padding-top: 5px; padding-left: 10px;">
                        DC No.:<%= srf?.customer_dc %>
                    </th>
                    <th style="text-align: right; padding-top: 5px; padding-right: 10px;">
                        DC Date: <%= srf?.customer_dc_date %>
                    </th>
                </tr>
                <tr>
                    <th style="text-align: center; padding-top: 10px;" colspan="2">DELIVERY CHALLAN</th>
                </tr>
            </table>

            <table style="width: 100%; border-bottom: 2px solid black; 
                border-left: 2px solid black; border-right: 2px solid black; border-collapse: collapse;">
                <tr>
                    <th
                        style="text-align: left; width: 50%; border-collapse: collapse; 
                        border-right: 2px solid black; vertical-align: baseline; padding-left: 10px; padding-top: 10px;">
                        <p style="margin-bottom: 5px;">To,</p>
                        <p>
                            M/s. <%= srf?.contact_name %>
                        </p>
                    </th>
                    <th style="text-align: left; width: 50%; border-collapse: collapse; padding-left: 10px; 
                        padding-top: 10px; padding-bottom: 10px;">
                        <p style="margin-bottom: 7px;">
                            SRF No. <%= srf?.srf_number %>
                        </p>
                        <p style="margin-bottom: 7px;">
                            SRF Date: <%= srf?.srf_date %>
                        </p>
                        <p style="margin-bottom: 7px;">
                            Customer DC No: <%= srf?.customer_dc %>
                        </p>
                        <p style="margin-bottom: 7px;">
                            Customer DC Date: <%= srf?.customer_dc_date %>
                        </p>
                        <p style="margin-bottom: 7px;">
                            Contact Person: <%= srf?.contact_name %>
                        </p>
                        <p>
                            Contact No: <%= srf?.contact_number %>
                        </p>
                    </th>
                </tr>
            </table>

            <table style="width: 100%; border-bottom: 2px solid black; border-left: 2px solid black; 
                border-right: 2px solid black; border-collapse: collapse;">
                <tr style="border-bottom: 2px solid black;">
                    <th
                        style="text-align: center; width: auto; border-collapse: collapse; 
                        border-right: 2px solid black; vertical-align: middle; padding-bottom: 10px; padding-top: 10px;">
                        <p>Sl No.</p>
                    </th>
                    <th
                        style="text-align: center; width: auto; border-collapse: collapse; 
                        border-right: 2px solid black; vertical-align: middle; padding-bottom: 10px; padding-top: 10px;">
                        <p>Description of Delivery Items</p>
                    </th>
                    <th style="text-align: center; width: auto; border-collapse: collapse; 
                        border-right: 2px solid black; vertical-align: middle; padding-bottom: 10px; padding-top: 10px;
                        padding-left: 5px; padding-right: 5px;">
                        <p>Qty</p>
                    </th>
                    <th
                        style="text-align: center; width: auto; border-collapse: collapse; 
                        border-right: 2px solid black; vertical-align: middle; padding-bottom: 10px; padding-top: 10px;">
                        <p>Model</p>
                    </th>
                    <th
                        style="text-align: center; width: auto; border-collapse: collapse; 
                        border-right: 2px solid black; vertical-align: middle; padding-bottom: 10px; padding-top: 10px;">
                        <p>Serial No.</p>
                    </th>
                    <th
                        style="text-align: left; width: auto; border-collapse: collapse; 
                        border-right: 2px solid black; vertical-align: baseline; padding-left: 10px; padding-top: 10px;">
                        <p>Remarks</p>
                    </th>
                    <th
                        style="text-align: left; width: auto; border-collapse: collapse; 
                        border-right: 2px solid black; vertical-align: baseline; padding-left: 10px; padding-top: 10px;">
                        <p>Item Value</p>
                    </th>
                </tr>

                <% var sl_no=1 ; %>
                    <% for (let i=0; i < items.length; i++) {%>
                        <tr>
                            <th
                                style="text-align: center; width: auto; border-collapse: collapse; 
                            border-right: 2px solid black; vertical-align: middle; padding-bottom: 10px; padding-top: 10px;">
                                <p>
                                    <%= sl_no+i %>
                                </p>
                            </th>
                            <th style="text-align: center; width: auto; border-collapse: collapse; width: 250px;
                                border-right: 2px solid black; vertical-align: middle; padding-bottom: 10px; padding-top: 10px;
                                padding-left: 5px; padding-right: 5px;">
                                <p>
                                    <%= items[i].intrument_type.instrument_full_name %>
                                </p>
                            </th>
                            <th style="text-align: center; width: auto; border-collapse: collapse; 
                                border-right: 2px solid black; vertical-align: middle; padding-bottom: 10px; padding-top: 10px;
                                padding-left: 5px; padding-right: 5px;">
                                <p>
                                    <%= items[i].srf_item_no %>
                                </p>
                            </th>
                            <th
                                style="text-align: center; width: auto; border-collapse: collapse; 
                                border-right: 2px solid black; vertical-align: middle; padding-bottom: 10px; padding-top: 10px;">
                                <p>
                                    <%= items[i].model %>
                                </p>
                            </th>
                            <th
                                style="text-align: center; width: auto; border-collapse: collapse; 
                                border-right: 2px solid black; vertical-align: middle; padding-bottom: 10px; padding-top: 10px;">
                                <p>
                                    <%= items[i].serial_no %>
                                </p>
                            </th>
                            <th
                                style="text-align: center; width: auto; border-collapse: collapse; 
                                border-right: 2px solid black; vertical-align: middle; padding-left: 10px; padding-top: 10px;">
                                <p>
                                    <%= items[i].remarks %>
                                </p>
                            </th>
                            <th
                                style="text-align: center; width: auto; border-collapse: collapse; 
                                border-right: 2px solid black; vertical-align: middle; padding-left: 10px; padding-top: 10px;">
                                <p>-</p>
                            </th>
                        </tr>
                        <% } %>

                            <tr style="border-top: 2px solid black; border-bottom: 2px solid black;">
                                <th colspan="6"
                                    style="border-right: 2px solid black; text-align: right; padding-right: 5px;">
                                    Total
                                </th>
                                <th>

                                </th>
                            </tr>
            </table>

            <table style="width: 100%; border-bottom: 2px solid black; border-left: 2px solid black; 
                border-right: 2px solid black; border-collapse: collapse;">
                <tr>
                    <td style="padding-left: 10px; padding-top: 10px; padding-bottom: 40px;">
                        Name & Signature of the CSD
                    </td>
                </tr>
            </table>

            <table style="width: 100%; border-bottom: 2px solid black; border-left: 2px solid black; 
                border-right: 2px solid black; border-collapse: collapse;">
                <tr>
                    <th
                        style="text-align: left; width: 50%; border-collapse: collapse; 
                        border-right: 2px solid black; vertical-align: baseline; padding-left: 10px; padding-top: 10px;">
                        <p style="margin-bottom: 5px;">
                            <%= dc_remarks %>
                        </p>
                    </th>
                    <th style="text-align: left; width: 50%; border-collapse: collapse; padding-left: 10px; 
                        padding-top: 10px; padding-bottom: 10px;">
                        <p style="margin-bottom: 7px;">
                            <% if (returnable_material) { %>
                                <input type="checkbox" checked /> Returnable Material
                                <% } else{%>
                                    <input type="checkbox" /> Returnable Material
                                    <%} %>

                        </p>
                    </th>
                </tr>
            </table>

        </div>

        <div class="bottomSection" style="margin-top: 15px;">
            <table style="width: 100%; border: 2px solid black; border-collapse: collapse;">
                <tr>
                    <td style="width: 85%;">
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <td style="border-right: 2px solid black; border-bottom: 2px solid black;
                                    padding-top: 5px; padding-left: 5xp; padding-bottom: 5px; padding-left: 5px;">
                                    <p>
                                        Issue No. <%= srf?.issue_no %>
                                    </p>
                                </td>
                                <td style="border-right: 2px solid black; border-bottom: 2px solid black;
                                    padding-top: 5px; padding-left: 5xp; padding-bottom: 5px; padding-left: 5px;">
                                    <p>
                                        Amend. No.: <%= srf?.amend_no %>
                                    </p>
                                </td>
                                <td style="border-right: 2px solid black; border-bottom: 2px solid black;
                                    padding-top: 5px; padding-left: 5xp; padding-bottom: 5px; padding-left: 5px;">
                                    --
                                </td>
                            </tr>
                            <tr>
                                <td style="border-right: 2px solid black;
                                    padding-top: 5px; padding-left: 5xp; padding-bottom: 5px; padding-left: 5px;">
                                    <p>
                                        Issue Date: <%= srf?.issue_date %>
                                    </p>
                                </td>
                                <td style="border-right: 2px solid black;
                                    padding-top: 5px; padding-left: 5xp; padding-bottom: 5px; padding-left: 5px;">
                                    <p>
                                        Amend. Date: <%= srf?.amend_date %>
                                    </p>
                                </td>
                                <td style="border-right: 2px solid black;
                                    padding-top: 5px; padding-left: 5xp; padding-bottom: 5px; padding-left: 5px;">
                                    --
                                </td>
                            </tr>
                        </table>
                    </td>
                    <td style="text-align: center;">------</td>
                </tr>
            </table>
        </div>

    </div>

</body>

</html>